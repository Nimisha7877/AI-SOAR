# ============================================================================
# AI SOAR - environment template
# ----------------------------------------------------------------------------
# Copy to .env and fill in:      copy .env.example .env
# .env is gitignored. NEVER commit real secrets.
# Every variable overrides the matching key in config/settings.yaml.
# ============================================================================

# --- LLM explainer ---------------------------------------------------------
# provider: ollama | openai | anthropic | gemini
AI_SOAR_LLM_PROVIDER=ollama
AI_SOAR_LLM_MODEL=llama3.1
AI_SOAR_LLM_BASE_URL=http://localhost:11434
# Leave blank for local ollama. Required for hosted providers.
AI_SOAR_LLM_API_KEY=

# --- n8n orchestration -----------------------------------------------------
AI_SOAR_N8N_BASE_URL=http://localhost:5678
AI_SOAR_N8N_API_KEY=
# Optional tuning (defaults shown): one attempt, short timeout, fail-open.
# AI_SOAR_N8N_TIMEOUT=3.0
# Advertised host for callback URLs sent inside n8n payloads (reverse proxy):
# AI_SOAR_API_BASE_URL=http://localhost:8000

# --- response layer --------------------------------------------------------
# simulated (safe demo) | live (real infrastructure)
AI_SOAR_RESPONSE_BACKEND=simulated

# --- misc ------------------------------------------------------------------
AI_SOAR_LOG_LEVEL=INFO
AI_SOAR_API_HOST=0.0.0.0
AI_SOAR_API_PORT=8000
# Browser origins allowed to call the API (comma-separated, or * behind auth):
# AI_SOAR_CORS_ORIGINS=http://localhost:8000,http://localhost:3000